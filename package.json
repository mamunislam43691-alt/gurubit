{
  "name": "gurubit-sms-otp-platform",
  "version": "1.0.0",
  "description": "Mobile-first temporary phone number platform for receiving SMS and OTP messages",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch"
  },
  "keywords": [
    "sms",
    "otp",
    "phone-number",
    "temporary-number"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^10.7.1",
    "firebase-admin": "^12.0.0",
    "nodemailer": "^8.0.7",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
