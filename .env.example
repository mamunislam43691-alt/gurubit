# ─── GURUBIT Environment Variables ───────────────────────────────────────────
# Copy this file to .env for local development
# Set these as Railway Environment Variables in the Railway dashboard

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Admin Panel ───────────────────────────────────────────────────────────────
# Set a strong password for the admin panel
ADMIN_PASSWORD=your_strong_admin_password_here

# ── Firebase (Required for user auth & social features) ───────────────────────
# Get from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase Database URL (optional — for Realtime Database)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Web API Key (for client-side auth)
FIREBASE_API_KEY=your_firebase_api_key

# ── SMTP Email (Optional — for verification emails) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="GURUBIT" <your_email@gmail.com>

# ── Debug Flags (set to false in production) ──────────────────────────────────
MUTE_FIREBASE_WARNINGS=false
DEBUG_WS=false
DEBUG_POLLING=false
DEBUG_SMS=false
