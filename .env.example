# ─── Database ────────────────────────────────────────────────────────
# Single source-of-truth database: MongoDB
# Examples:
#   Local:        mongodb://127.0.0.1:27017/gurubit
#   Atlas:        mongodb+srv://<user>:<pass>@<host>/<db>?retryWrites=true&w=majority
#   Railway:      mongodb://mongo:27017/gurubit  (Docker service)
#   Render:       provided by Render Key-Value store as env var
MONGODB_URI=mongodb://127.0.0.1:27017/gurubit
MONGODB_DB=gurubit

# ─── Server ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Admin Panel ──────────────────────────────────────────────────────
ADMIN_PASSWORD=your_strong_admin_password_here

# ─── Sessions/JWT ─────────────────────────────────────────────────────
SESSION_SECRET=replace_with_long_random_string_minimum_32_chars
SESSION_EXPIRY_HOURS=24

# ─── Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="GURUBIT" <your_email@gmail.com>

APP_URL=http://localhost:3000

# ─── Debug Flags ─────────────────────────────────────────────────────
MUTE_FIREBASE_WARNINGS=false
DEBUG_WS=false
DEBUG_POLLING=false
DEBUG_SMS=false
